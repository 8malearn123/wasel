# Copy to .env and fill in. Values are read at build time by Vite.
# These three are PUBLIC by design — they ship inside the browser bundle.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put a service_role key, or any other server secret, in this file or in
# any VITE_* variable: everything prefixed VITE_ is compiled into the bundle and
# is readable by anyone who opens the site. Server secrets belong in
# Supabase → Edge Functions → Secrets.
